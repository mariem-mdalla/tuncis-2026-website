# ===================================================================
# TUNCIS 2026 - Environment Variables Template
# Copy this file to .env in `apps/backend/.env` (for local development)
# and configure these same keys in your Vercel Project Settings (for production).
# ===================================================================

# 1. PostgreSQL Database (Neon Serverless PostgreSQL)
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require

# 2. Email Sending (Nodemailer using Google Workspace / Gmail SMTP)
# The sender email address (e.g. tuncis2026@horizon-tech.tn or a Gmail account)
EMAIL_USER=tuncis2026@horizon-tech.tn

# 3. Google App Password (16 characters generated from Google Account > Security > 2FA > App Passwords)
# IMPORTANT: This is NOT the normal Gmail login password!
EMAIL_APP_PASSWORD=your_16_char_app_password_here

# 4. Notification Email (Organizer Inbox)
# The email address that receives notifications whenever:
#   - A participant registers
#   - A participant submits an abstract PDF
# If not set, defaults to EMAIL_USER.
NOTIFY_EMAIL=tuncis2026@horizon-tech.tn

# 5. Optional Port for local Express backend (default: 3001)
PORT=3001
